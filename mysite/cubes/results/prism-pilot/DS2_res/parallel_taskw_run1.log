con <- DBI::dbConnect(RSQLite::SQLite(), ":memory:")
df_part <- read_csv("tests-examples/prism-pilots/DS2/tables/part.csv", skip=1, col_names=c('p_partkey','p_name','p_container','p_comment'), col_types=cols(col_integer(),col_character(),col_character(),col_character()))
df_part <- copy_to(con, df_part)
expected_output <- read_csv("tests-examples/prism-pilots/DS2/expected.csv", skip=1, col_names=c('p_partkey','p_name','p_comment'), col_types=cols(col_integer(),col_character(),col_character()))

df1 <- df_part %>% filter(p_container == 'SM CASE' | p_container == 'SM BOX')
out <- df1 %>% select(p_partkey, p_name, p_comment) %>% arrange(p_partkey)


+++++++++++++++++++++++++++++++++++++ SQL Solution +++++++++++++++++++++++++++++++++++++

SELECT `p_partkey`,
       `p_name`,
       `p_comment`
FROM `df_part`
WHERE (`p_container` = 'SM CASE'
       OR `p_container` = 'SM BOX')
ORDER BY p_partkey

